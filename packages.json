    {
      "repository": "Ectonomic/ectomatter-game-configurator",
      "publisher": "Ectonomic",
      "versions": [
        {
          "manifest": {
            "id": "game-configurator",
            "kind": "plugin",
            "name": "Game Configurator",
            "version": "1.0.0",
            "protocol": 4,
            "ectomatter": "0.1.0",
            "module": "core.wasm",
            "license": "GPL-3.0-only",
            "description": "Proton, prefixes, gamescope, GameMode and MangoHud for each game.",
            "glyph": "glyph.svg",
            "adds": [
              "game"
            ],
            "systems": [
              "linux"
            ],
            "uses": [
              {
                "launch": {
                  "wrap": {
                    "gamescope": {
                      "options": {
                        "-W": "number",
                        "-H": "number",
                        "-w": "number",
                        "-h": "number",
                        "-r": "number",
                        "-F": "word",
                        "-S": "word",
                        "-f": null,
                        "--hdr-enabled": null,
                        "--hdr-itm-enabled": null,
                        "--hdr-itm-sdr-nits": "number",
                        "--hdr-itm-target-nits": "number",
                        "--mangoapp": null
                      },
                      "last": "--"
                    },
                    "gamemoderun": {},
                    "mangohud": {}
                  },
                  "tools": [
                    "winecfg",
                    "winetricks"
                  ],
                  "env": {
                    "PROTON_ENABLE_HDR": "number",
                    "PROTON_DLSS_UPGRADE": "number",
                    "PROTON_FSR4_UPGRADE": "number",
                    "PROTON_XESS_UPGRADE": "number",
                    "PROTON_NO_NTSYNC": "number",
                    "PROTON_NO_FSYNC": "number",
                    "PROTON_USE_WINED3D": "number",
                    "PROTON_LOG": "number",
                    "PROTON_ENABLE_WAYLAND": "number",
                    "PROTON_PREFER_SDL": "number",
                    "PROTON_USE_SDL": "number",
                    "PROTON_DISABLE_HIDRAW": "number",
                    "PROTON_SONY_AUTO_XINPUT": "number",
                    "PROTON_ENABLE_NVAPI": "number",
                    "PROTON_HIDE_NVIDIA_GPU": "number",
                    "DXVK_HDR": "number",
                    "DXVK_FRAME_RATE": "number",
                    "VKD3D_FRAME_RATE": "number",
                    "ENABLE_GAMESCOPE_WSI": "number",
                    "WINEDLLOVERRIDES": "list",
                    "WINE_CPU_TOPOLOGY": "list",
                    "SDL_GAMECONTROLLER_IGNORE_DEVICES": "list",
                    "MANGOHUD_CONFIG": "list"
                  }
                }
              }
            ]
          },
          "sha256": "c2303875d364051b2fe7c143acb39e1a505f060eb98a7acf4a7a9106348814a7"
        }
